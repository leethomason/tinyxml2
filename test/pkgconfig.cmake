if (IS_ABSOLUTE "${INSTALL_LIBDIR}")
    set(expected_libdir "${INSTALL_LIBDIR}")
else ()
    set(expected_libdir "\${exec_prefix}/${INSTALL_LIBDIR}")
endif ()
if (IS_ABSOLUTE "${INSTALL_INCLUDEDIR}")
    set(expected_includedir "${INSTALL_INCLUDEDIR}")
else ()
    set(expected_includedir "\${prefix}/${INSTALL_INCLUDEDIR}")
endif ()

file(STRINGS "${PKGCONFIG_FILE}" actual_libdir REGEX "^libdir=")
file(STRINGS "${PKGCONFIG_FILE}" actual_includedir REGEX "^includedir=")
if (NOT actual_libdir STREQUAL "libdir=${expected_libdir}")
    message(FATAL_ERROR "Unexpected libdir: ${actual_libdir}")
endif ()
if (NOT actual_includedir STREQUAL "includedir=${expected_includedir}")
    message(FATAL_ERROR "Unexpected includedir: ${actual_includedir}")
endif ()
